{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "deCDN",
  "description": "Decentralized CDN — staked nodes cache and serve content over QUIC, paid per-MB via off-chain USDC channels.",
  "colors": {
    "primary": "#0f9d6a",
    "light": "#1dc889",
    "dark": "#0a7250"
  },
  "favicon": "/favicon-dark.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://decdn.org"
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      { "label": "decdn.org", "href": "https://decdn.org" },
      { "label": "Blog", "href": "https://decdn.org/blog/" }
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.decdn.org"
    },
    "organization": {
      "id": "https://decdn.org/#organization",
      "name": "deCDN",
      "url": "https://decdn.org/",
      "logo": "https://decdn.org/d_logo.png",
      "sameAs": [
        "https://github.com/decdn",
        "https://x.com/decdn_",
        "https://www.linkedin.com/company/decdn"
      ]
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "fonts": {
      "family": "Geist"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "overview/introduction",
              "overview/architecture",
              "overview/participants",
              "overview/how-it-works",
              "overview/design-decisions",
              "overview/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Protocol",
        "groups": [
          {
            "group": "Foundations",
            "pages": ["protocol/content-addressing", "protocol/network"]
          },
          {
            "group": "Payments",
            "pages": ["protocol/payments"]
          },
          {
            "group": "Privacy",
            "pages": ["protocol/privacy"]
          },
          {
            "group": "Accountability & Governance",
            "pages": [
              "protocol/reputation",
              "protocol/slashing",
              "protocol/governance",
              "protocol/takedown"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://decdn.org",
      "github": "https://github.com/decdn",
      "x": "https://x.com/decdn_",
      "linkedin": "https://www.linkedin.com/company/decdn"
    },
    "links": [
      {
        "header": "deCDN",
        "items": [
          { "label": "Website", "href": "https://decdn.org" },
          { "label": "Blog", "href": "https://decdn.org/blog/" },
          {
            "label": "Litepaper",
            "href": "https://decdn.org/decdn_litepaper.pdf"
          }
        ]
      },
      {
        "header": "Contact",
        "items": [
          { "label": "info@decdn.org", "href": "mailto:info@decdn.org" }
        ]
      }
    ]
  }
}
